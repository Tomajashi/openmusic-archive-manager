# OpenMusic Archive Manager — Example Environment Configuration

# Web Interface Port
OPENMUSIC_PORT=8080

# NAS / Host User & Group IDs for file ownership
PUID=1000
PGID=1000

# Host path to your final music library (mounted as /music in container)
MUSIC_HOST_PATH=./music

# Database Configuration (Default: SQLite in /app/config/openmusic.db)
# For PostgreSQL, set e.g.: postgresql://user:pass@postgres:5432/openmusic
DATABASE_URL=

# Concurrency & Storage Quotas
SEARCH_CONCURRENCY=5
DOWNLOAD_CONCURRENCY=3
MAX_STORAGE_GB=500
LOG_LEVEL=INFO

# Music Source API Keys
JAMENDO_CLIENT_ID=
MUSOPEN_API_KEY=

# PirateBay / Torrent Indexer & Client Configuration
PIRATEBAY_ENABLED=true
PIRATEBAY_API_URL=https://apibay.org
TORZNAB_URL=
TORZNAB_API_KEY=
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
TRANSMISSION_URL=

# Navidrome Integration
NAVIDROME_ENABLED=false
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_PORT=4533
NAVIDROME_USER=
NAVIDROME_PASSWORD=
NAVIDROME_MUSIC_PATH=/music
