# OpenMusic Archive Manager — Example Environment Configuration

# Web Interface Port
OPENMUSIC_PORT=8080

# NAS / Host User & Group IDs for file ownership
PUID=1000
PGID=1000

# Host path to your final music library (mounted as /music in container)
MUSIC_HOST_PATH=./music

# Database Configuration (Default: SQLite in /app/config/openmusic.db)
# For PostgreSQL, set e.g.: postgresql://user:pass@postgres:5432/openmusic
DATABASE_URL=

# Concurrency & Storage Quotas
SEARCH_CONCURRENCY=5
DOWNLOAD_CONCURRENCY=3
MAX_STORAGE_GB=500
LOG_LEVEL=INFO

# Music Source API Keys
JAMENDO_CLIENT_ID=
MUSOPEN_API_KEY=

# PirateBay / Torrent Indexer & Client Configuration
PIRATEBAY_ENABLED=true
PIRATEBAY_API_URL=https://apibay.org
TORZNAB_URL=
TORZNAB_API_KEY=
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
TRANSMISSION_URL=

# FLAC Music Finder Web Index (opt-in cookie source, disabled by default)
# The site sits behind Cloudflare and serves a JavaScript bot challenge to visitors
# without a valid session, so this source only works with a cookie you copy from your
# own logged-in browser session. It is never bypassed automatically.
FLACMUSICFINDER_ENABLED=false
FLACMUSICFINDER_BASE_URL=https://flacmusicfinder.top
FLACMUSICFINDER_COOKIE=
# Leave empty to try the built-in search URL guesses, or set the exact search request
# (use {query} as the placeholder), e.g.:
# FLACMUSICFINDER_SEARCH_PATH=/search.php?do=dload&story={query}
FLACMUSICFINDER_SEARCH_PATH=
# Optional: override the browser User-Agent paired with the copied cookie.
FLACMUSICFINDER_USER_AGENT=
# How many result pages are opened per search to collect per-file links (0-20).
FLACMUSICFINDER_MAX_DETAILS=5
# Extra comma-separated hosts that hold the actual files (added to the download allowlist).
FLACMUSICFINDER_EXTRA_DOWNLOAD_HOSTS=

# Navidrome Integration
NAVIDROME_ENABLED=false
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_PORT=4533
NAVIDROME_USER=
NAVIDROME_PASSWORD=
NAVIDROME_MUSIC_PATH=/music
